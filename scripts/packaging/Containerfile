FROM docker.io/library/rust:1-bookworm@sha256:510c9199edebf02aacc5df8628c84728f9fd1085aa0c1c50c829b284f302faad AS rust
FROM docker.io/library/ubuntu:22.04@sha256:79676deb51ebb02885b0b9d33788e78a37cf1045ad79d1bb04c6a222c3556b3d
COPY --from=rust /usr/local/cargo /usr/local/cargo
COPY --from=rust /usr/local/rustup /usr/local/rustup
ENV PATH="/usr/local/cargo/bin:${PATH}" RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo CARGO_BUILD_JOBS=4
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    build-essential pkg-config libxkbcommon-dev libpixman-1-dev \
    bubblewrap ffmpeg xkb-data xwayland x11-xkb-utils patchelf python3 ca-certificates git \
    && rm -rf /var/lib/apt/lists/*
# Ubuntu 22.04's Xwayland predates xwayland-shell, required by our compositor.
RUN sed -n 's/^deb /deb-src /p' /etc/apt/sources.list > /etc/apt/sources.list.d/autoscope-sources.list \
    && apt-get update && apt-get build-dep -y --no-install-recommends xwayland \
    && apt-get install -y --no-install-recommends libffi-dev libexpat1-dev \
    && rm -rf /var/lib/apt/lists/*
ENV PATH="/opt/autoscope-x11/bin:${PATH}" PKG_CONFIG_PATH=/opt/autoscope-x11/lib/pkgconfig:/opt/autoscope-x11/share/pkgconfig LD_LIBRARY_PATH=/opt/autoscope-x11/lib
COPY build-xwayland.py xwayland-sources.json /opt/build-xwayland/
RUN python3 /opt/build-xwayland/build-xwayland.py
WORKDIR /source
